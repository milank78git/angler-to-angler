{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "rootDirs": ["app/src/main/assets", "web/catch-card"],
    "types": [],
    "skipLibCheck": true
  },
  "include": ["app/src/main/assets/**/*.js", "web/**/*.js", "types/**/*.d.ts", "tests/types/**/*.ts"]
}
